# ─── OpenAI (primary LLM — required) ─────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Anthropic / Claude (optional — not used by default) ─────────────────────
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── WordPress Site ───────────────────────────────────────────────────────────
WP_BASE_URL=https://yoursite.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ─── PostgreSQL (primary — required for production) ───────────────────────────
POSTGRES_URL=postgresql+asyncpg://seo_agent:password@localhost:5432/seo_agent
# Sync URL for Celery / Alembic (same DB, different driver)
POSTGRES_SYNC_URL=postgresql://seo_agent:password@localhost:5432/seo_agent
# LangGraph checkpoint URL (plain psycopg3 connection string)
LANGGRAPH_CHECKPOINT_URL=postgresql://seo_agent:password@localhost:5432/seo_agent

# ─── Redis (required for Celery broker + result backend) ──────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── SQLite fallback (dev only — overridden by POSTGRES_URL when set) ─────────
# DATABASE_URL=sqlite+aiosqlite:///./data/seo_agent.db

# ─── Google Services (optional but recommended) ───────────────────────────────
# GOOGLE_PAGESPEED_API_KEY=your-key-here
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS=./credentials/gsc_credentials.json

# ─── SERP Tracking (optional) ─────────────────────────────────────────────────
# SERP_API_KEY=your-serpapi-key-here
# Free alternative: fixed competitor seeds (comma-separated)
# SEO_AGENT_COMPETITOR_URLS=https://competitor1.com/page-a,https://competitor2.com/blog/topic
# SEO_AGENT_COMPETITOR_DOMAINS=competitor1.com,competitor2.com

# ─── App Settings ─────────────────────────────────────────────────────────────
# SEO_AGENT_ENV=production
# SEO_AGENT_LOG_LEVEL=INFO
# SEO_AGENT_API_SECRET=change-me-in-production
# PUBLIC_HOST=your-server-ip-or-domain
# SEO_AGENT_ALLOWED_ORIGINS=http://your-server-ip-or-domain:8501

# ─── Email Notifications ──────────────────────────────────────────────────────
# SEO_AGENT_EMAIL_ENABLED=true
# SEO_AGENT_EMAIL_SMTP_HOST=smtp.gmail.com
# SEO_AGENT_EMAIL_SMTP_PORT=587
# SEO_AGENT_EMAIL_SMTP_USER=your@gmail.com
# SEO_AGENT_EMAIL_SMTP_PASSWORD=your-app-password
# SEO_AGENT_EMAIL_FROM_ADDRESS=seo-agent@yourcompany.com
# SEO_AGENT_EMAIL_FROM_NAME=SEO Agent
# Comma-separated — add as many as needed
# SEO_AGENT_EMAIL_RECIPIENTS=alice@company.com,bob@company.com,carol@company.com
# SEO_AGENT_EMAIL_APP_BASE_URL=https://your-dashboard.com
# SEO_AGENT_STREAMLIT_URL=https://your-dashboard.com

# ─── Policy Engine ────────────────────────────────────────────────────────────
# SEO_AGENT_POLICY_META_COOLDOWN_DAYS=14
# SEO_AGENT_POLICY_CONTENT_COOLDOWN_DAYS=21
